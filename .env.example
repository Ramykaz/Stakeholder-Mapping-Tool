# ─────────────────────────────────────────────────────────────────────────────
# Stakeholder Analysis Tool — Environment Configuration
# Copy this file to .env and fill in your values before running docker compose.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Supabase).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Groq API key — used by the NER and reasoning apps (future stories).
# Not required for document ingestion, but the app will warn at startup if missing.
GROQ_API_KEY=gsk_your_groq_api_key_here

# Django debug mode. Set to True for local development, False for production.
DEBUG=True

# Comma-separated list of allowed hostnames.
# For local development: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1
