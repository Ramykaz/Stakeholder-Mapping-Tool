# ─────────────────────────────────────────────────────────────────────────────
# Stakeholder Analysis Tool — Environment Configuration
# Copy this file to .env and fill in your values before running docker compose.
# ─────────────────────────────────────────────────────────────────────────────

# US-015 provider wiring notes:
# - You only need the credentials for the provider selected in project settings.
# - "Test connection" in Settings validates the currently selected provider/model.
# - Changing provider in Settings should take effect immediately for new AI actions.

# PostgreSQL connection string (Supabase).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Groq API key — used by the NER and reasoning apps (future stories).
# Not required for document ingestion, but the app will warn at startup if missing.
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI API key — used when running NER with provider=openai.
# Optional unless OpenAI provider is selected.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Gemini API key — used when running NER/workflows with provider=gemini.
# Optional unless Gemini provider is selected.
GEMINI_API_KEY=your_gemini_api_key_here

# Azure OpenAI settings — used when provider=azure_openai.
# Optional unless Azure OpenAI provider is selected.
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
# Optional override; defaults to 2024-08-01-preview if omitted.
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Django debug mode. Set to True for local development, False for production.
DEBUG=True

# Django secret key (required for production).
SECRET_KEY=change-me-in-production

# Comma-separated list of allowed hostnames.
# For local development: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Production security settings (recommended defaults shown)
# For local dev, these can be left as-is with DEBUG=True.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# Optional comma-separated list, e.g. https://app.example.com,https://api.example.com
CSRF_TRUSTED_ORIGINS=

# Celery broker/backend for background generation jobs.
# Local docker-compose default points to redis service.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Sentry error monitoring (optional — leave blank to disable).
# Get your DSN from https://sentry.io → Project Settings → Client Keys.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Fraction of transactions to capture for performance tracing (0.0 – 1.0).
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional release tag (e.g. git SHA). Set in CI/CD for precise error grouping.
# SENTRY_RELEASE=abc1234
